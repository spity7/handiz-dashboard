# Copy to .env and fill in secrets before running

PORT=5016
MONGO_URL=mongodb://127.0.0.1:27017/handiz
LOG_LEVEL=debug
NODE_ENV=development
JWT_SECRET=change-me-local-secret
JWT_LIFETIME=7d
# Gmail SMTP (app password) — required for LMS + project notification emails
EMAIL_USER=
EMAIL_PASS=
BASE_URL=http://localhost:5016
HANDIZ_SITE_URL=http://localhost:3000
LMS_SITE_URL=http://localhost:3001
COOKIE_DOMAIN=
LESSON_DEVICE_ENFORCED=true
GCS_BUCKET_NAME=
GCS_KEYFILE=./gcs-key.json
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=https://handiz.org
WHISH_ENVIRONMENT=
WHISH_SUCCESS_URL=
WHISH_CANCEL_URL=
# Shop order redirects after Whish (optional; default uses HANDIZ_SITE_URL + /shop/orders/{orderId})
WHISH_SHOP_SUCCESS_URL=http://localhost:3000/shop/orders/{orderId}?payment=success
# WHISH_SHOP_SUCCESS_URL=https://handiz.org/shop/orders/{orderId}?payment=success
WHISH_SHOP_CANCEL_URL=http://localhost:3000/shop/orders/{orderId}?payment=failed
# WHISH_SHOP_CANCEL_URL=https://handiz.org/shop/orders/{orderId}?payment=failed
# Flat USD shipping added to shop checkout totals (server-calculated)
SHOP_SHIPPING_FEE_USD=5
VDOCIPHER_API_SECRET_KEY=
VDOCIPHER_WEBHOOK_SECRET=
VDOCIPHER_API_BASE=https://dev.vdocipher.com/api
VDOCIPHER_OTP_TTL=300
# LMS refreshes OTP before this TTL expires; increase for long sessions if needed.
VDOCIPHER_WATERMARK=1
# OTP requests include whitelisthref from LMS_SITE_URL; also allow localhost in the VdoCipher dashboard for local dev.
DASHBOARD_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
